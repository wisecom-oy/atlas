# Required. docker compose refuses to start while either is empty.
# Generate the password with: openssl rand -hex 32
MINIO_ROOT_USER=atlas-backup-admin
MINIO_ROOT_PASSWORD=

# Host address the ports are published on. 127.0.0.1 keeps MinIO reachable from this machine
# only. Set a LAN address, or 0.0.0.0 for every interface, only with TLS in front of it.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
