{
  "$schema": "https://v2-10-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // tsbuildinfo must be cached alongside dist: composite tsc writes it to the
      // package root, and if it survives while dist is restored from cache, tsc
      // reports "up to date" and silently skips re-emitting stale .d.ts files.
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format:check": {}
  }
}
