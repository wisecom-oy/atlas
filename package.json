{
  "name": "atlas-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "release:version": "pnpm -r --filter './packages/*' exec npm version --no-git-tag-version",
    "link-cli": "pnpm --filter @wisecom/atlas-cli run build && pnpm --filter @wisecom/atlas-cli run link-cli",
    "lint:fix": "eslint packages/*/src/ packages/*/tests/ --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\"",
    "format:check": "turbo run format:check",
    "perf:build": "tsc --project tools/perf/tsconfig.json",
    "perf:backup": "node tools/perf/dist/cli.js profile -- backup",
    "perf:restore": "node tools/perf/dist/cli.js profile -- restore",
    "perf:analyze": "node tools/perf/dist/cli.js analyze",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "typescript-language-server": "^5.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": "prettier --write"
  },
  "packageManager": "pnpm@10.30.3"
}
