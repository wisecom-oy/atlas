{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Tests index fixtures they just built; an out-of-range index fails the test on the
    // spot, so the `!` noise buys nothing here. Every other strict check stays on.
    "noUncheckedIndexedAccess": false,
    // Sibling packages resolve through their published types, not their sources. The
    // source mappings in tsconfig.json rely on the project-reference redirect, which
    // `composite: false` turns off: without this override the sibling's own `@/`
    // imports would be resolved against this package and fail (issue #155).
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
